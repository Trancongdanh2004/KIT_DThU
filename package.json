{
  "name": "ris-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bộ giao diện RIS (dựa trên DThU Kit, đã tuỳ chỉnh) đóng gói thành registry shadcn để tái sử dụng.",
